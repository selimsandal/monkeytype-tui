#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"

echo 'Checking recording system packages...'
packages=(ca-certificates curl unzip xvfb x11-utils xdotool openbox dbus-x11 ffmpeg fonts-dejavu-core libgl1-mesa-dri)
missing=()
for package in "${packages[@]}"; do
  dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed' || missing+=("$package")
done
if ((${#missing[@]})); then
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}"
fi

echo 'Checking Node and pnpm...'
node -e 'if (Number(process.versions.node.split(".")[0]) < 22) process.exit(1)'
if [[ "$(pnpm --version 2>/dev/null || :)" != 12.0.0 ]]; then
  corepack install -g pnpm@12.0.0
fi
pnpm install --frozen-lockfile

echo 'Checking Bun 1.3.10...'
if [[ "$(bun --version 2>/dev/null || :)" != 1.3.10 ]]; then
  case "$(uname -m)" in
    x86_64) bun_arch=x64 ;;
    aarch64) bun_arch=aarch64 ;;
    *) echo 'Unsupported Bun architecture' >&2; exit 1 ;;
  esac
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v1.3.10/bun-linux-${bun_arch}.zip" -o "$tmp/bun.zip"
  unzip -q "$tmp/bun.zip" -d "$tmp"
  mkdir -p "$HOME/.local/bin"
  install -m 755 "$tmp/bun-linux-${bun_arch}/bun" "$HOME/.local/bin/bun"
  rm -rf "$tmp"
  trap - EXIT
fi

echo 'Checking Ghostty 1.3.1 for recording...'
if [[ "$(ghostty +version 2>/dev/null | head -1 || :)" != 'Ghostty 1.3.1' ]]; then
  [[ "$(uname -m)" == x86_64 ]] || { echo 'Ghostty AppImage recording requires x86_64' >&2; exit 1; }
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' EXIT
  curl -fsSL 'https://github.com/pkgforge-dev/ghostty-appimage/releases/download/v1.3.1/Ghostty-1.3.1-x86_64.AppImage' -o "$tmp"
  echo "fde48d2b716afd1978766879bbf1aae30dd305e8ad86a1037a2614a14d82dc28  $tmp" | sha256sum -c -
  mkdir -p "$HOME/.local/bin"
  install -m 755 "$tmp" "$HOME/.local/bin/ghostty"
  rm -f "$tmp"
  trap - EXIT
fi

echo 'Preparing recording Python packages...'
uv run --no-project --with pexpect==4.9.0 --with pyte==0.8.2 --with pillow==12.3.0 --with mss==10.2.0 \
  python -c 'import pexpect, pyte, PIL, mss'
echo 'Orb setup ready.'
